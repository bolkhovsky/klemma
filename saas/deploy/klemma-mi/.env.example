# Секреты личного контура MI. Копировать в /opt/klemma-mi/.env на VPS,
# режим 600, владелец deploy. В репозиторий значения не попадают никогда.

# Подпись JWT (openssl rand -hex 32)
KLEMMA_JWT_SECRET=

# Общий токен, который klemma-stt шлёт заголовком X-Ingest-Token.
# То же значение — в ~/klemma-stt/.env.worker на fram.
KLEMMA_BONUM_INGEST_TOKEN=

# Ключ Anthropic для /ask и аналитики (тот же, что у остальных стеков на машине)
ANTHROPIC_API_KEY=

# Необязательные переопределения
# KLEMMA_BONUM_AI_MODEL=anthropic/claude-haiku-4-5-20251001
# KLEMMA_EGRESS_PROXY=http://172.17.0.1:8888
