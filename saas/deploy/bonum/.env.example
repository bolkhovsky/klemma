# Bonum portal stack secrets — copy to /opt/bonum/deploy/.env on the VPS.
# (ANTHROPIC_API_KEY already exists on the box — reuse the klemma/miz value.)

# Strong random secret for JWT signing (openssl rand -hex 32)
KLEMMA_JWT_SECRET=

# Shared token the Nodul webhook must send as the X-Ingest-Token header
KLEMMA_BONUM_INGEST_TOKEN=

# Anthropic key for the /ask RAG answer (reuse the box's existing key)
ANTHROPIC_API_KEY=

# Optional overrides
# KLEMMA_BONUM_AI_MODEL=anthropic/claude-haiku-4-5-20251001
# KLEMMA_EGRESS_PROXY=http://172.17.0.1:8888
